# sandbox.env — variables de entorno DENTRO del container del agente.
#
# 🔒 REGLA DE ORO: poné valores FAKE para TODO lo que tu código lea.
# El objetivo es que cualquier intento de llamar a un servicio real (DB,
# APIs externas, storage, facturación) falle RUIDOSO en vez de tocar prod.
# El agente trabaja en un clone aislado; no debe tener forma de pegarle a
# nada real desde acá.
#
# Copiá este archivo a .delegate/sandbox.env y reemplazá las claves por las
# que TU proyecto consume — todas con mocks.

NODE_ENV=development

# --- Ejemplos de mocks (borralos y poné los tuyos) ---

# Base de datos: apuntá a un host que no resuelve
DATABASE_URL=postgres://nowhere/mock-no-real-db
MONGODB_URI=mongodb://nowhere/mock-no-real-db

# Secrets/JWT: valores que NO son los reales
JWT_SECRET=mock-jwt-not-for-prod-and-not-real

# APIs externas: tokens fake → cualquier request real responde 401
EXTERNAL_API_KEY=mock-api-key-fake
EXTERNAL_API_TOKEN=mock-token-fake

# Storage: bucket inexistente → uploads fallan explícitamente
STORAGE_BUCKET=sandbox-mock-does-not-exist

# Indicador para que código que lo respete sepa que está en sandbox
DELEGATION_SANDBOX=1
